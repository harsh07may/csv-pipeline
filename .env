# --- Blob storage (Garage) ---
# DEMO-ONLY credentials. Garage creates this key at startup (see docker-compose.yml).
# Generate your own with:
#   key id : echo "GK$(openssl rand -hex 16)"
#   secret : openssl rand -hex 32
S3_ACCESS_KEY=GKd1488ae23f42f8bda2ff1b103d9a4b2e
S3_SECRET_KEY=fbb7722d8340757bfb28883d26e33a157af13d93975316b65128733804eee5c2
S3_BUCKET=csv-uploads
S3_REGION=garage
S3_INTERNAL_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# DEMO-ONLY credentials for the local Postgres container (see docker-compose.yml).
# Change the password for anything that is not your own machine.
POSTGRES_USER=csv
POSTGRES_PASSWORD=csv_dev_password
POSTGRES_DB=csv_pipeline
# The app's connection string. Keep user, password and db name in sync with the three lines above.
DATABASE_URL=postgresql+psycopg://csv:csv_dev_password@postgres:5432/csv_pipeline
SQL_ECHO=false # log SQL statement by SQLAlchemy 

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Processing ---
# Artificial pause per batch so you can watch live progress. Set to 0 for real speed.
SIMULATED_DELAY_SECONDS=0.3